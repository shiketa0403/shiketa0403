# dropcatch_jp.py 用の環境変数テンプレート
# 使い方:
#   1) このファイルをコピー:  cp dropcatch_jp.env.example dropcatch_jp.env
#   2) 値を埋める
#   3) 読み込んで実行:        set -a; source dropcatch_jp.env; set +a
#                            python3 dropcatch_jp.py --preflight   # まず疎通確認
#                            python3 dropcatch_jp.py               # 本番

# ---- 必須: 認証・対象 ----
export VD_API_KEY="ここにValue DomainのAPIキー"
export VD_DOMAIN="example.jp"          # 取りたいドメイン

# ---- タイミング ----
export VD_START_AT="2026-06-01T00:00:00"  # JST。この時刻まで待ってから開始（空なら即開始）
export VD_DEADLINE_SEC="1800"             # 開始後この秒数で諦める（30分）
export VD_REG_INTERVAL="2.0"              # 登録リトライ間隔(秒)。短すぎるとレート制限の恐れ

# ---- 取得条件 ----
export VD_YEARS="1"
# export VD_NS="ns1.value-domain.com,ns2.value-domain.com"   # 省略可（標準NS）
export VD_WHOIS_PROXY="1"   # 1=Whois情報公開代理を使う / 0=自分の情報を公開

# ---- 登録者情報（.jp はレジストリ必須なのは登録者のみ）----
export VD_LASTNAME="Yamada"
export VD_FIRSTNAME="Taro"
export VD_ORG="personal"          # 個人なら personal、法人なら正式名称
export VD_COUNTRY="JP"
export VD_POSTALCODE="530-0011"
export VD_STATE="Osaka"
export VD_CITY="Osaka-shi Kita-ku"
export VD_ADDRESS1="3-1 Ofuka-cho"
export VD_ADDRESS2="Grand Front Osaka Tower B 23F"
export VD_EMAIL="you@example.com"
export VD_PHONE="+81.676342727"   # 国際表記 +81.XXXXXXXXX
# export VD_FAX="+81.676342728"   # 省略時は PHONE と同じ
